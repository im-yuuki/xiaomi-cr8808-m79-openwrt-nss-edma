CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_wpad-basic-mbedtls=m
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_zram-swap=y

# Extra modules (=m): built into this build`s package repository on gh-pages,
# not into the image. They are what users can `apk add` on top of a matching image.
# Source: kuncy7/openwrt-nss-edma .github/ci/ipq50xx/kmods-extra.config
CONFIG_PACKAGE_kmod-wireguard=m
CONFIG_PACKAGE_kmod-tun=m
CONFIG_PACKAGE_kmod-usb-net-rndis=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=m
